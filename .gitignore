# The brain is its own git repository (see docs/decisions/0001), and lives on
# the always-on machine — not here. Anchored to the repository root: a bare
# `brain/` matches ANY directory of that name at any depth, which silently
# excluded apps/api/secondshift/brain/, openspec/specs/brain/, and the archived
# change's spec deltas from every commit. The tests were tracked; the module
# they test was not.
/brain/

# Claude Code local settings — permission rules and overrides for one machine,
# not for everyone who clones a public repository. The shared conventions belong
# in .claude/settings.json; anything session- or host-specific belongs here.
.claude/settings.local.json

# OS
.DS_Store

# Python virtualenv
.venv/

# Next.js build output
apps/web/out/
