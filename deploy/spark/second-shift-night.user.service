[Unit]
Description=Second Shift night pipeline (work the queued entries)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/second-shift
Environment=SECOND_SHIFT_DB=%h/second-shift-data/second-shift.db
Environment=SECOND_SHIFT_BRAIN=%h/second-shift-brain
# No timeout override. One night is bounded by the reasoner's own
# `reasoner_timeout_s` per completion, and a systemd timeout firing mid-stage
# would kill the process between a stage's insert and its close — which the
# pipeline survives by design, but which loses the stage that was in flight for
# no reason a shorter deadline would gain.
ExecStart=%h/second-shift/apps/api/.venv/bin/python -m secondshift.night run
